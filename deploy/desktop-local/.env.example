# Cloud Memo — 로컬 데스크톱 (개발·PC 허브)
# Docker는 Postgres만, API/Web은 호스트에서 실행 (scripts/dev-all.ps1)

APP_ENV=development
DATA_DIR=./data

POSTGRES_USER=memo
POSTGRES_PASSWORD=memo
POSTGRES_DB=memo

JWT_SECRET=dev-change-me-not-for-production
INITIAL_USER_PASSWORD=1234
INITIAL_USER_EMAIL=admin@localhost

CORS_ORIGINS=http://localhost:3000,http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

MAX_UPLOAD_MB=25

# Windows 개발 시 web/.env.local 에도 NEXT_PUBLIC_API_URL 동일하게
