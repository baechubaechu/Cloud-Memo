# Cloud Memo — 본인 클라우드 VM (AWS Lightsail, Hetzner, OCI 등)
# 내 계정·내 VM — 벤더 메모 SaaS 아님
# 설정은 VPS 프로필과 동일; 호스터만 다름

APP_ENV=production
DATA_DIR=/opt/cloud-memo/data

POSTGRES_USER=memo
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=memo

JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
INITIAL_USER_PASSWORD=change-me-strong
INITIAL_USER_EMAIL=admin@localhost

DOMAIN=memo.example.com
CORS_ORIGINS=https://memo.example.com
NEXT_PUBLIC_API_URL=https://memo.example.com

MAX_UPLOAD_MB=25
WORKER_TOKEN=
