# Cloud Memo — 집 허브 (저전력 기기) 프로필
# 라즈베리 파이 5 4GB+ / NAS 등 24h 가동 장치용

APP_ENV=production

# 허브 기기 로컬 경로 (예: /var/lib/cloud-memo/data)
DATA_DIR=/var/lib/cloud-memo/data

POSTGRES_USER=memo
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=memo

JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
INITIAL_USER_PASSWORD=change-me-strong
INITIAL_USER_EMAIL=admin@localhost

# LAN IP 또는 Tailscale 호스트명 (프런트 빌드 시 박힘 — 변경 후 재빌드)
# 예: http://192.168.0.50:8000  또는  http://memo-hub.tailnet-name.ts.net:8000
NEXT_PUBLIC_API_URL=http://192.168.0.50:8000
CORS_ORIGINS=http://192.168.0.50:3000,http://192.168.0.50:8000

API_PORT=8000
WEB_PORT=3000
MAX_UPLOAD_MB=25

# (선택) Tailscale 등 — README 참고, compose 밖에서 설정
