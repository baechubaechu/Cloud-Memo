# Default site = whatever DOMAIN is set to (defaults to localhost).
# Set DOMAIN=memo.example.com on the caddy service for automatic HTTPS via Let's Encrypt.
{$DOMAIN:localhost} {
    encode zstd gzip

    # 공통 보안 헤더. (CSP는 Pretendard webfont를 jsdelivr에서 가져오므로 fonts/data 도메인 허용)
    header {
        # 브라우저가 mime sniffing 으로 콘텐츠 타입을 추측하지 않도록.
        X-Content-Type-Options "nosniff"
        # 클릭재킹 방지.
        X-Frame-Options "DENY"
        # referrer 노출 최소화.
        Referrer-Policy "strict-origin-when-cross-origin"
        # 권한 정책 — 카메라/마이크/위치 사용 안 함.
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        # 호스트가 https 일 때만 HSTS 적용 (Caddy는 HTTPS 자동 활성화 시에만 의미가 있음)
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # CSP — Next.js inline 스크립트 사용을 위해 'unsafe-inline' 허용. 이미지 data:/blob: 첨부 미리보기 허용.
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; font-src 'self' https://cdn.jsdelivr.net data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        # 서버 이름 노출 제거.
        -Server
    }

    handle /api/* {
        reverse_proxy memo-api:8000
    }

    handle {
        reverse_proxy memo-web:3000
    }
}
