# Cloud Memo — 개인 인스턴스 환경 변수
# 프로필별 예시: deploy/vps/.env.example, deploy/hub/, deploy/desktop-local/, deploy/cloud/
# 사용법 (루트 compose): cp .env.example .env → 수정 → docker compose up -d --build

# --- 환경 모드 ---
# production 으로 두면 약한 기본값 사용 시 API가 시작되지 않음 (사고 방지).
APP_ENV=development

# --- 데이터 루트 ---
# 호스트 디스크에서 DB / 첨부파일을 보관할 위치.
#   VPS 권장: /opt/cloud-memo/data
#   로컬:    ./data
DATA_DIR=./data

# --- Postgres ---
POSTGRES_USER=memo
POSTGRES_PASSWORD=memo
POSTGRES_DB=memo

# --- 인증 (단일 비밀번호 잠금) ---
# JWT_SECRET 운영용 생성 예:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string

# 첫 부트스트랩 시 만들어지는 사용자의 비밀번호. 한 번 만들어지면 이 변수를 바꿔도
# 자동으로 갱신되지 않음 (README 의 "비밀번호를 바꾸려면" 참조).
INITIAL_USER_PASSWORD=1234

# 내부 식별자(로그인 시 사용 안 함, 호환을 위해서만 존재).
INITIAL_USER_EMAIL=admin@localhost

# --- API 동작 ---
CORS_ORIGINS=http://localhost:3000,http://localhost
MAX_UPLOAD_MB=25

# 프런트 빌드 시 박히는 API 주소. 모바일/외부에서 접근하려면 LAN/도메인으로 교체 후 재빌드.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- 워커 (선택) ---
# AI 워커가 큐를 폴링할 때 쓰는 토큰. 비워두면 워커가 동작하지 않음.
WORKER_TOKEN=

# --- Caddy / 외부 노출 ---
# 도메인 보유 시 도메인 그대로 두면 Let's Encrypt 자동 HTTPS.
# 로컬에서만 띄우면 localhost.
DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
